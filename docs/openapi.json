  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bookshop_session"
      }
    },
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isbn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          },
          "format": {
            "enum": [
              "paperback",
              "hardcover",
              "ebook",
              "unspecified"
            ]
          },
          "priceCents": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "stocked": {
            "type": "boolean"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "coverId": {
            "type": "integer"
          },
          "language": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editionPublishDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "descriptionSourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "descriptionLevel": {
            "enum": [
              "work",
              "edition"
            ]
          },
          "descriptionTruncated": {
            "type": "boolean"
          },
          "detailsFetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceKind": {
            "enum": [
              "seed",
              "openlibrary"
            ]
          },
          "admissionFormat": {
            "enum": [
              "paperback",
              "hardcover",
              "ebook",
              "unspecified"
            ]
          },
          "metadataWarning": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workId",
          "title",
          "authors",
          "category",
          "subjects",
          "isbn",
          "format",
          "priceCents",
          "stock",
          "stocked",
          "sourceUrl",
          "fetchedAt"
        ]
      },
      "CartLine": {
        "type": "object",
        "properties": {
          "book": {
            "$ref": "#/components/schemas/Book"
          },
          "quantity": {
            "type": "integer"
          },
          "subtotalCents": {
            "type": "integer"
          }
        },
        "required": [
          "book",
          "quantity",
          "subtotalCents"
        ]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartLine"
            }
          },
          "totalCents": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "currency": {
            "const": "USD"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "lines",
          "totalCents",
          "count",
          "currency",
          "version"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cart": {
            "$ref": "#/components/schemas/Cart"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "cart",
          "expiresAt",
          "label"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quoteId": {
            "type": "string"
          },
          "cart": {
            "$ref": "#/components/schemas/Cart"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "quoteId",
          "cart",
          "createdAt",
          "label"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "ChatResult": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Book"
            }
          },
          "cart": {
            "$ref": "#/components/schemas/Cart"
          },
          "mode": {
            "enum": [
              "ai",
              "offline"
            ]
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "warning": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "books",
          "cart",
          "mode"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
