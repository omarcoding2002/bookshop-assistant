# With no API key, the app uses the explicitly labelled offline demonstration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cloud: PostgreSQL connection string. Local: leave blank for persistent PGlite.
DATABASE_URL=
LOCAL_DB_PATH=.data/postgres
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
OPEN_LIBRARY_CONTACT=
LIVE_BOOK_SEARCH=false
MODEL_BUDGET_USD=20
MODEL_INPUT_USD_PER_MILLION=2
MODEL_OUTPUT_USD_PER_MILLION=10
NODE_ENV=development
