{
  "name": "bookshop-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:refresh": "node --import tsx scripts/refresh-catalogue.ts",
    "check": "npm run build && npm test",
    "eval": "node --import tsx scripts/evaluate.ts",
    "format": "prettier --write .",
    "openapi": "node --import tsx scripts/openapi.ts",
    "eval:performance": "node --import tsx scripts/performance.ts",
    "eval:accuracy": "node --import tsx scripts/evaluate-accuracy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@electric-sql/pglite": "^0.3.10",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.2"
  }
}
